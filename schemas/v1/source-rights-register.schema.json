{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HarborLens source-rights review register (SPEC-003)",
  "description": "Fail-closed inventory of source-rights decisions (SPEC-003, FR-010, NFR-013, NFR-019, BR-015, BR-016). https URLs use an ASCII hostname; punycode is accepted. IPv6 literals, raw IDN hostnames, userinfo, an uppercase scheme, and any whitespace, a backslash, and C0/C1 controls fail closed. Ports, when present, are 1-65535. reviewed_at_utc is a UTC timestamp with a T separator, ASCII digits, no fraction or 1 to 6 fractional digits, and a Z or +00:00 suffix. A string that only ends in Z is rejected. A file that starts with a UTF-8 BOM is a load error and is not an approval. Whitespace-only reviewer or attribution text is rejected when decision is reviewed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "purpose": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "dataset_version",
          "source_url",
          "terms_url",
          "rights_status",
          "decision",
          "permitted_uses",
          "attribution",
          "reviewed_by",
          "reviewed_at_utc",
          "terms_sha256",
          "evidence_url",
          "review_note"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[a-z0-9_]{3,100}$"
          },
          "dataset_version": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "pattern": "^https://[A-Za-z0-9][A-Za-z0-9.-]*[A-Za-z0-9](?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:[/?#][^\\s\\\\\\x00-\\x1f\\x7f-\\x9f]*)?(?![\\s\\S])"
          },
          "terms_url": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^https://[A-Za-z0-9][A-Za-z0-9.-]*[A-Za-z0-9](?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:[/?#][^\\s\\\\\\x00-\\x1f\\x7f-\\x9f]*)?(?![\\s\\S])"
          },
          "rights_status": {
            "enum": [
              "review_required",
              "reviewed_public_domain_attribution_required",
              "reviewed_permitted_with_conditions"
            ]
          },
          "decision": {
            "enum": [
              "pending",
              "reviewed"
            ]
          },
          "permitted_uses": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "research",
              "public_aggregates",
              "commercial"
            ],
            "properties": {
              "research": {
                "enum": [
                  "allowed",
                  "prohibited",
                  "unreviewed"
                ]
              },
              "public_aggregates": {
                "enum": [
                  "allowed",
                  "prohibited",
                  "unreviewed"
                ]
              },
              "commercial": {
                "enum": [
                  "allowed",
                  "prohibited",
                  "unreviewed"
                ]
              }
            }
          },
          "attribution": {
            "type": [
              "string",
              "null"
            ]
          },
          "reviewed_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "reviewed_at_utc": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^([0-9]{4})-([0-9]{2})-([0-9]{2})T([0-9]{2}):([0-9]{2}):([0-9]{2})(?:\\.([0-9]{1,6}))?(?:Z|\\+00:00)(?![\\s\\S])"
          },
          "terms_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "evidence_url": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^https://[A-Za-z0-9][A-Za-z0-9.-]*[A-Za-z0-9](?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:[/?#][^\\s\\\\\\x00-\\x1f\\x7f-\\x9f]*)?(?![\\s\\S])"
          },
          "review_note": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "decision": {
                  "const": "reviewed"
                }
              },
              "required": [
                "decision"
              ]
            },
            "then": {
              "properties": {
                "rights_status": {
                  "enum": [
                    "reviewed_public_domain_attribution_required",
                    "reviewed_permitted_with_conditions"
                  ]
                },
                "attribution": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "reviewed_by": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "reviewed_at_utc": {
                  "type": "string",
                  "pattern": "^([0-9]{4})-([0-9]{2})-([0-9]{2})T([0-9]{2}):([0-9]{2}):([0-9]{2})(?:\\.([0-9]{1,6}))?(?:Z|\\+00:00)(?![\\s\\S])"
                },
                "terms_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "evidence_url": {
                  "type": "string",
                  "pattern": "^https://[A-Za-z0-9][A-Za-z0-9.-]*[A-Za-z0-9](?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:[/?#][^\\s\\\\\\x00-\\x1f\\x7f-\\x9f]*)?(?![\\s\\S])"
                },
                "terms_url": {
                  "type": "string",
                  "pattern": "^https://[A-Za-z0-9][A-Za-z0-9.-]*[A-Za-z0-9](?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:[/?#][^\\s\\\\\\x00-\\x1f\\x7f-\\x9f]*)?(?![\\s\\S])"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "decision": {
                  "const": "pending"
                }
              },
              "required": [
                "decision"
              ]
            },
            "then": {
              "properties": {
                "rights_status": {
                  "const": "review_required"
                },
                "permitted_uses": {
                  "properties": {
                    "research": {
                      "const": "unreviewed"
                    },
                    "public_aggregates": {
                      "const": "unreviewed"
                    },
                    "commercial": {
                      "const": "unreviewed"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
