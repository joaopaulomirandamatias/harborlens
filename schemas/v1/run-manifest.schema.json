{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/joaopaulomirandamatias/harborlens/main/schemas/v1/run-manifest.schema.json",
  "title": "Actual v0.1 local run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input_file",
    "input_sha256",
    "output",
    "bbox_lon_lat",
    "counts",
    "note",
    "events",
    "method_parameters",
    "run_id",
    "provenance_schema_version",
    "source_metadata",
    "artifacts",
    "provenance_warning",
    "analysis_window",
    "input_truncated"
  ],
  "properties": {
    "input_file": {
      "type": "string"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "output": {
      "type": "string"
    },
    "bbox_lon_lat": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false
    },
    "counts": {
      "type": "object",
      "required": [
        "total",
        "in_bbox",
        "invalid",
        "outside_bbox",
        "duplicate",
        "written"
      ],
      "additionalProperties": false,
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "in_bbox": {
          "type": "integer",
          "minimum": 0
        },
        "invalid": {
          "type": "integer",
          "minimum": 0
        },
        "outside_bbox": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate": {
          "type": "integer",
          "minimum": 0
        },
        "written": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "note": {
      "type": "string"
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vessels",
        "points",
        "moving_or_invalid_points",
        "stationary_candidates",
        "censoring",
        "warning"
      ],
      "properties": {
        "vessels": {
          "type": "integer",
          "minimum": 0
        },
        "points": {
          "type": "integer",
          "minimum": 0
        },
        "moving_or_invalid_points": {
          "type": "integer",
          "minimum": 0
        },
        "stationary_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "warning": {
          "type": "string"
        },
        "censoring": {
          "type": "object",
          "additionalProperties": false,
          "description": "Per-run BR-019 censoring counts; left/right counts overlap in both_censored.",
          "required": [
            "rule_version",
            "left_censored",
            "right_censored",
            "both_censored",
            "uncensored",
            "unknown"
          ],
          "properties": {
            "rule_version": {
              "const": "window-edge-v1"
            },
            "left_censored": {
              "type": "integer",
              "minimum": 0
            },
            "right_censored": {
              "type": "integer",
              "minimum": 0
            },
            "both_censored": {
              "type": "integer",
              "minimum": 0
            },
            "uncensored": {
              "type": "integer",
              "minimum": 0
            },
            "unknown": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "method_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_sog_knots",
        "min_duration_minutes",
        "max_gap_minutes",
        "max_radius_m",
        "min_points"
      ],
      "properties": {
        "max_sog_knots": {
          "type": "number"
        },
        "min_duration_minutes": {
          "type": "number"
        },
        "max_gap_minutes": {
          "type": "number"
        },
        "max_radius_m": {
          "type": "number"
        },
        "min_points": {
          "type": "number"
        }
      }
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provenance_schema_version": {
      "const": "1.1"
    },
    "source_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_url",
        "metadata_origin",
        "rights_status"
      ],
      "properties": {
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "metadata_origin": {
          "const": "user_declared"
        },
        "rights_status": {
          "const": "review_required"
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "houston_clean.csv",
        "stationary_candidates.csv",
        "stationary_candidates.geojson"
      ],
      "properties": {
        "houston_clean.csv": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "stationary_candidates.csv": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "stationary_candidates.geojson": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "provenance_warning": {
      "type": "string",
      "minLength": 10
    },
    "analysis_window": {
      "type": "object",
      "additionalProperties": false,
      "description": "Analysis window used for BR-019 censoring flags. Describes observation coverage, not vessel activity.",
      "required": [
        "status",
        "rule_version",
        "edge_tolerance_minutes",
        "blocks",
        "internal_gaps",
        "declarations",
        "observed_time_range"
      ],
      "properties": {
        "status": {
          "enum": [
            "known",
            "unknown"
          ]
        },
        "rule_version": {
          "const": "window-edge-v1"
        },
        "edge_tolerance_minutes": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start_utc",
              "end_utc"
            ],
            "properties": {
              "start_utc": {
                "type": "string",
                "format": "date-time"
              },
              "end_utc": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        "internal_gaps": {
          "type": "integer",
          "minimum": 0
        },
        "declarations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "input",
              "source"
            ],
            "properties": {
              "input": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "enum": [
                  "extraction_sidecar",
                  "erddap_sidecar",
                  "user_declared",
                  "none"
                ]
              },
              "start_utc": {
                "type": "string",
                "format": "date-time"
              },
              "end_utc": {
                "type": "string",
                "format": "date-time"
              },
              "sidecar_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "ignored_reason": {
                "const": "input_truncated_by_max_rows"
              }
            }
          }
        },
        "observed_time_range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start_utc",
            "end_utc"
          ],
          "properties": {
            "start_utc": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "end_utc": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            }
          }
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "known"
          }
        }
      },
      "then": {
        "properties": {
          "blocks": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "blocks": {
            "maxItems": 0
          },
          "internal_gaps": {
            "const": 0
          }
        }
      }
    },
    "input_truncated": {
      "type": "boolean",
      "description": "True when --max-rows stopped ingestion before the end of the input."
    }
  }
}
