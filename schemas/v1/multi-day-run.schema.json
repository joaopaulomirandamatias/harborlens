{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/joaopaulomirandamatias/harborlens/main/schemas/v1/multi-day-run.schema.json",
  "title": "HarborLens Multi-day Historical Run Manifest v1.1",
  "description": "Local input SHA-256 and historical candidate lineage; not authoritative vessel identification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "schema_version",
    "input_files",
    "bbox_lon_lat",
    "counts",
    "events",
    "method_parameters",
    "source_rights_status",
    "run_id",
    "artifacts",
    "warning",
    "analysis_window",
    "limits",
    "resources",
    "code_version",
    "mmsi_categories"
  ],
  "properties": {
    "mode": {
      "const": "multi_day_historical"
    },
    "schema_version": {
      "const": "multi-day-1.1"
    },
    "input_files": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "filename",
          "sha256",
          "size_bytes",
          "rights_status",
          "source_ref",
          "rows_scanned"
        ],
        "properties": {
          "source_id": {
            "type": "integer",
            "minimum": 0
          },
          "filename": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "rights_status": {
            "const": "review_required"
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "rows_scanned": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "bbox_lon_lat": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number"
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "missing_value",
        "invalid",
        "outside_bbox",
        "duplicate",
        "duplicate_across_files",
        "written"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "outside_bbox": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate_across_files": {
          "type": "integer",
          "minimum": 0
        },
        "written": {
          "type": "integer",
          "minimum": 0
        },
        "missing_value": {
          "type": "integer",
          "minimum": 0,
          "description": "Rows with an empty required field (not available), counted separately from malformed values."
        },
        "invalid": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "description": "Diagnostics from the shared segmentation engine (stationary-v0.2); counts are QA, not traffic statistics.",
      "required": [
        "vessels",
        "points",
        "moving_points",
        "timestamp_conflicts",
        "gap_splits",
        "identity_conflicts",
        "implausible_jumps",
        "spatial_splits",
        "discarded_groups",
        "stationary_candidates",
        "discarded_by_reason",
        "candidates_per_mmsi",
        "cross_day_candidates",
        "censoring",
        "warning"
      ],
      "properties": {
        "vessels": {
          "type": "integer",
          "minimum": 0
        },
        "points": {
          "type": "integer",
          "minimum": 0
        },
        "moving_points": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp_conflicts": {
          "type": "integer",
          "minimum": 0
        },
        "gap_splits": {
          "type": "integer",
          "minimum": 0
        },
        "identity_conflicts": {
          "type": "integer",
          "minimum": 0
        },
        "implausible_jumps": {
          "type": "integer",
          "minimum": 0
        },
        "spatial_splits": {
          "type": "integer",
          "minimum": 0
        },
        "discarded_groups": {
          "type": "integer",
          "minimum": 0
        },
        "stationary_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "discarded_by_reason": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "too_few_points",
            "too_short",
            "radius_exceeded"
          ],
          "properties": {
            "too_few_points": {
              "type": "integer",
              "minimum": 0
            },
            "too_short": {
              "type": "integer",
              "minimum": 0
            },
            "radius_exceeded": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "candidates_per_mmsi": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max",
            "mmsi_with_multiple"
          ],
          "properties": {
            "max": {
              "type": "integer",
              "minimum": 0
            },
            "mmsi_with_multiple": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "cross_day_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "censoring": {
          "type": "object",
          "additionalProperties": false,
          "description": "Per-run BR-019 censoring counts; left/right counts overlap in both_censored.",
          "required": [
            "rule_version",
            "left_censored",
            "right_censored",
            "both_censored",
            "uncensored",
            "unknown"
          ],
          "properties": {
            "rule_version": {
              "const": "window-edge-v1"
            },
            "left_censored": {
              "type": "integer",
              "minimum": 0
            },
            "right_censored": {
              "type": "integer",
              "minimum": 0
            },
            "both_censored": {
              "type": "integer",
              "minimum": 0
            },
            "uncensored": {
              "type": "integer",
              "minimum": 0
            },
            "unknown": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "warning": {
          "type": "string"
        }
      }
    },
    "method_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method_version",
        "max_sog_knots",
        "min_duration_minutes",
        "max_gap_minutes",
        "max_radius_m",
        "min_points",
        "max_jump_knots",
        "parameter_set"
      ],
      "properties": {
        "method_version": {
          "const": "stationary-v0.2"
        },
        "max_sog_knots": {
          "type": "number",
          "minimum": 0
        },
        "min_duration_minutes": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_gap_minutes": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_radius_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "min_points": {
          "type": "integer",
          "minimum": 2
        },
        "max_jump_knots": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "parameter_set": {
          "type": "string",
          "pattern": "^[a-f0-9]{12}$",
          "description": "Fingerprint of method_version plus segmentation thresholds; candidates from different threshold sets never share it."
        }
      }
    },
    "source_rights_status": {
      "const": "review_required"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "houston_clean.csv",
        "stationary_candidates.csv",
        "stationary_candidates.geojson"
      ],
      "properties": {
        "houston_clean.csv": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "stationary_candidates.csv": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "stationary_candidates.geojson": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "warning": {
      "type": "string",
      "minLength": 10
    },
    "analysis_window": {
      "type": "object",
      "additionalProperties": false,
      "description": "Analysis window used for BR-019 censoring flags. Describes observation coverage, not vessel activity.",
      "required": [
        "status",
        "rule_version",
        "edge_tolerance_minutes",
        "blocks",
        "internal_gaps",
        "declarations",
        "observed_time_range"
      ],
      "properties": {
        "status": {
          "enum": [
            "known",
            "unknown"
          ]
        },
        "rule_version": {
          "const": "window-edge-v1"
        },
        "edge_tolerance_minutes": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start_utc",
              "end_utc"
            ],
            "properties": {
              "start_utc": {
                "type": "string",
                "format": "date-time"
              },
              "end_utc": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        "internal_gaps": {
          "type": "integer",
          "minimum": 0
        },
        "declarations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "input",
              "source"
            ],
            "properties": {
              "input": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "enum": [
                  "extraction_sidecar",
                  "erddap_sidecar",
                  "user_declared",
                  "none"
                ]
              },
              "start_utc": {
                "type": "string",
                "format": "date-time"
              },
              "end_utc": {
                "type": "string",
                "format": "date-time"
              },
              "sidecar_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "ignored_reason": {
                "const": "input_truncated_by_max_rows"
              }
            }
          }
        },
        "observed_time_range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start_utc",
            "end_utc"
          ],
          "properties": {
            "start_utc": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "end_utc": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            }
          }
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "known"
          }
        }
      },
      "then": {
        "properties": {
          "blocks": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "blocks": {
            "maxItems": 0
          },
          "internal_gaps": {
            "const": 0
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "description": "Fail-closed caps applied to this run (#35).",
      "required": [
        "max_points",
        "max_scratch_mib",
        "max_export_mib"
      ],
      "properties": {
        "max_points": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6000000
        },
        "max_scratch_mib": {
          "type": "integer",
          "minimum": 16,
          "maximum": 2048
        },
        "max_export_mib": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scratch_peak_bytes",
        "scratch_measurement",
        "memory_bound"
      ],
      "properties": {
        "scratch_peak_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "scratch_measurement": {
          "type": "string"
        },
        "memory_bound": {
          "type": "object",
          "additionalProperties": false,
          "description": "Fixed SQLite working set. Cache, mmap_bytes, and temp_store are the enforced pin. soft_heap_limit_enforced says whether the soft heap request releases memory on this build. Scratch disk is a separate cap. This object does not validate a candidate.",
          "required": [
            "policy",
            "sqlite_cache_kib",
            "sqlite_soft_heap_bytes",
            "soft_heap_limit_enforced",
            "mmap_bytes",
            "temp_store",
            "grows_with_input_rows"
          ],
          "properties": {
            "policy": {
              "const": "fixed-sqlite-heap-v1"
            },
            "sqlite_cache_kib": {
              "const": 8192
            },
            "sqlite_soft_heap_bytes": {
              "const": 8388608
            },
            "soft_heap_limit_enforced": {
              "description": "True when PRAGMA compile_options lists ENABLE_MEMORY_MANAGEMENT. False when that list is readable and omits it. The string unknown when the list cannot be read. Cache size, mmap_bytes, and temp_store do not depend on this flag.",
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "const": "unknown"
                }
              ]
            },
            "mmap_bytes": {
              "const": 0
            },
            "temp_store": {
              "const": "FILE"
            },
            "grows_with_input_rows": {
              "const": false
            }
          }
        }
      }
    },
    "code_version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_version",
        "git_commit"
      ],
      "description": "harborlens package version (hashed into run_id) and, when known, the git commit (metadata only).",
      "properties": {
        "package_version": {
          "type": "string",
          "minLength": 1
        },
        "git_commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "mmsi_categories": {
      "type": "object",
      "description": "Accepted points per ITU-R M.585 MMSI category (QA flag; nothing is dropped).",
      "propertyNames": {
        "enum": [
          "ship",
          "group_of_ships",
          "coast_station",
          "sar_aircraft",
          "aid_to_navigation",
          "craft_associated_with_parent_ship",
          "handheld_vhf",
          "ais_sart",
          "mob_device",
          "epirb_ais",
          "placeholder",
          "leading_zero_ambiguous",
          "other"
        ]
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
