{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/joaopaulomirandamatias/harborlens/main/schemas/v1/usace-facility-source.schema.json",
  "title": "Point catalog source metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_agency",
    "service_url",
    "catalog_url",
    "queries",
    "geometric_type",
    "output_epsg",
    "license_status",
    "source_date_status",
    "retrieved_at_utc",
    "feature_count",
    "output_sha256",
    "warning"
  ],
  "properties": {
    "source_agency": {
      "type": "string"
    },
    "service_url": {
      "type": "string",
      "format": "uri"
    },
    "catalog_url": {
      "type": "string",
      "format": "uri"
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "geometric_type": {
      "const": "Point"
    },
    "output_epsg": {
      "const": 4326
    },
    "license_status": {
      "enum": [
        "review_required",
        "reviewed_public_domain_attribution_required",
        "reviewed_permitted_with_conditions",
        "use_restricted"
      ]
    },
    "source_date_status": {
      "type": "string"
    },
    "retrieved_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "feature_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000
    },
    "output_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "warning": {
      "type": "string",
      "minLength": 10
    },
    "rights_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source_id",
        "dataset_version",
        "purpose",
        "registry_sha256",
        "evaluation",
        "rights_status"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]{3,100}$"
        },
        "dataset_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "purpose": {
          "enum": [
            "research",
            "public_aggregates",
            "commercial"
          ]
        },
        "registry_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "evaluation": {
          "enum": [
            "not_supplied",
            "invalid_registry",
            "pending_or_unmatched",
            "reviewed_record"
          ]
        },
        "rights_status": {
          "enum": [
            "review_required",
            "reviewed_public_domain_attribution_required",
            "reviewed_permitted_with_conditions",
            "use_restricted"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evaluation": {
                "const": "not_supplied"
              }
            },
            "required": [
              "evaluation"
            ]
          },
          "then": {
            "properties": {
              "registry_sha256": {
                "type": "null"
              },
              "rights_status": {
                "const": "review_required"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evaluation": {
                "const": "invalid_registry"
              }
            },
            "required": [
              "evaluation"
            ]
          },
          "then": {
            "properties": {
              "rights_status": {
                "const": "review_required"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evaluation": {
                "const": "pending_or_unmatched"
              }
            },
            "required": [
              "evaluation"
            ]
          },
          "then": {
            "properties": {
              "rights_status": {
                "const": "review_required"
              },
              "registry_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evaluation": {
                "const": "reviewed_record"
              }
            },
            "required": [
              "evaluation"
            ]
          },
          "then": {
            "properties": {
              "registry_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "rights_status": {
                "enum": [
                  "reviewed_public_domain_attribution_required",
                  "reviewed_permitted_with_conditions",
                  "use_restricted"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
