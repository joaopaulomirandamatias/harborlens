{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/joaopaulomirandamatias/harborlens/main/schemas/v1/usace-facility-source.schema.json",
  "title": "Point catalog source metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_agency",
    "service_url",
    "catalog_url",
    "queries",
    "geometric_type",
    "output_epsg",
    "license_status",
    "source_date_status",
    "retrieved_at_utc",
    "feature_count",
    "output_sha256",
    "warning"
  ],
  "properties": {
    "source_agency": {
      "type": "string"
    },
    "service_url": {
      "type": "string",
      "format": "uri"
    },
    "catalog_url": {
      "type": "string",
      "format": "uri"
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "geometric_type": {
      "const": "Point"
    },
    "output_epsg": {
      "const": 4326
    },
    "license_status": {
      "const": "review_required"
    },
    "source_date_status": {
      "type": "string"
    },
    "retrieved_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "feature_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000
    },
    "output_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "warning": {
      "type": "string",
      "minLength": 10
    }
  }
}
