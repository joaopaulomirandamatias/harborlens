{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/joaopaulomirandamatias/harborlens/main/schemas/v1/ais-point.schema.json",
  "title": "Clean AIS point (transmitted, unverified)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mmsi",
    "timestamp_utc",
    "lat",
    "lon",
    "sog_knots",
    "vessel_type",
    "nav_status",
    "cog_deg",
    "heading_deg",
    "length_m",
    "width_m",
    "draft_m",
    "transceiver_class",
    "mmsi_category"
  ],
  "properties": {
    "mmsi": {
      "type": "string",
      "pattern": "^[0-9]{8,9}$"
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "lat": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "lon": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "sog_knots": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "vessel_type": {
      "type": "string",
      "description": "Transmitted ship-type text. The logical value has no neutralization apostrophe. The CSV writer may prefix one apostrophe when the cell matches the formula-trigger rule."
    },
    "nav_status": {
      "type": "string",
      "description": "Transmitted navigation-status text. The logical value has no neutralization apostrophe. The CSV writer may prefix one apostrophe when the cell matches the formula-trigger rule."
    },
    "cog_deg": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        {
          "const": ""
        }
      ]
    },
    "heading_deg": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 359
        },
        {
          "const": ""
        }
      ]
    },
    "length_m": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "const": ""
        }
      ]
    },
    "width_m": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "const": ""
        }
      ]
    },
    "draft_m": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "const": ""
        }
      ]
    },
    "transceiver_class": {
      "enum": [
        "A",
        "B",
        ""
      ]
    },
    "mmsi_category": {
      "enum": [
        "ship",
        "group_of_ships",
        "coast_station",
        "sar_aircraft",
        "aid_to_navigation",
        "craft_associated_with_parent_ship",
        "handheld_vhf",
        "ais_sart",
        "mob_device",
        "epirb_ais",
        "placeholder",
        "leading_zero_ambiguous",
        "other"
      ]
    }
  },
  "description": "Canonical cleaned AIS row. NOAA 'not available' sentinels (COG 360, heading 511, zero dimensions) are empty strings; mmsi_category is a QA flag (#39)."
}
