{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/joaopaulomirandamatias/harborlens/main/schemas/v1/ais-point.schema.json",
  "title": "Clean AIS point (transmitted, unverified)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mmsi",
    "timestamp_utc",
    "lat",
    "lon",
    "sog_knots",
    "vessel_type",
    "nav_status"
  ],
  "properties": {
    "mmsi": {
      "type": "string",
      "pattern": "^[0-9]{8,9}$"
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "lat": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "lon": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "sog_knots": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "vessel_type": {
      "type": "string"
    },
    "nav_status": {
      "type": "string"
    }
  }
}
