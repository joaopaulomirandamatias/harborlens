{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/joaopaulomirandamatias/harborlens/main/schemas/v1/multi-day-candidate-feature.schema.json",
  "title": "HarborLens Provisional Multi-day Candidate GeoJSON Feature",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "geometry",
    "properties"
  ],
  "properties": {
    "type": {
      "const": "Feature"
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "const": "Point"
        },
        "coordinates": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          ],
          "items": false
        }
      }
    },
    "properties": {
      "type": "object",
      "required": [
        "event_id",
        "mmsi",
        "start_utc",
        "end_utc",
        "duration_min",
        "point_count",
        "maximum_distance_m",
        "type",
        "method_version",
        "confidence_label",
        "source_count",
        "source_files",
        "crosses_utc_date",
        "left_censoring",
        "right_censoring"
      ],
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{18}$"
        },
        "mmsi": {
          "type": "string",
          "pattern": "^[0-9]{8,9}$"
        },
        "start_utc": {
          "type": "string",
          "format": "date-time"
        },
        "end_utc": {
          "type": "string",
          "format": "date-time"
        },
        "duration_min": {
          "type": "number",
          "minimum": 0
        },
        "point_count": {
          "type": "integer",
          "minimum": 1
        },
        "maximum_distance_m": {
          "type": "number",
          "minimum": 0
        },
        "type": {
          "const": "stationary_candidate"
        },
        "method_version": {
          "const": "stationary-multiday-v0.1"
        },
        "confidence_label": {
          "const": "unvalidated"
        },
        "source_count": {
          "type": "integer",
          "minimum": 1
        },
        "source_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "crosses_utc_date": {
          "type": "boolean"
        },
        "left_censoring": {
          "enum": [
            "censored",
            "not_censored",
            "unknown"
          ],
          "description": "BR-019 window-edge censoring of the observed start/end; 'censored' means duration_min is a lower bound."
        },
        "right_censoring": {
          "enum": [
            "censored",
            "not_censored",
            "unknown"
          ],
          "description": "BR-019 window-edge censoring of the observed start/end; 'censored' means duration_min is a lower bound."
        }
      }
    }
  }
}
