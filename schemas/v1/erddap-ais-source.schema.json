{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/joaopaulomirandamatias/harborlens/main/schemas/v1/erddap-ais-source.schema.json",
  "title": "NOAA PMEL ERDDAP AIS subset source receipt",
  "description": "Sidecar written by harborlens-fetch-erddap (SPEC-003, FR-010, NFR-013, NFR-019, BR-015, BR-016). rights_review is optional. A recorded rights_status is not permission to redistribute the source, and it is not a navigation or event label. The checked-in register stays review_required.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agency",
    "dataset",
    "dataset_metadata",
    "source_url",
    "time_start_utc",
    "time_end_utc",
    "bbox_lon_lat",
    "retrieved_at_utc",
    "raw_sha256",
    "csv_sha256",
    "response_bytes",
    "rows",
    "rights_status",
    "warning"
  ],
  "properties": {
    "agency": {
      "const": "NOAA/OAR/PMEL"
    },
    "dataset": {
      "const": "AIS2024_AIS"
    },
    "dataset_metadata": {
      "const": "https://data.pmel.noaa.gov/pmel/erddap/info/AIS2024_AIS/index.html"
    },
    "source_url": {
      "type": "string",
      "pattern": "^https://data\\.pmel\\.noaa\\.gov/pmel/erddap/tabledap/AIS2024_AIS\\.csv\\?"
    },
    "time_start_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z(?![\\s\\S])"
    },
    "time_end_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z(?![\\s\\S])"
    },
    "bbox_lon_lat": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number"
      }
    },
    "retrieved_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z(?![\\s\\S])"
    },
    "raw_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "csv_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "response_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "rows": {
      "type": "integer",
      "minimum": 1
    },
    "rights_status": {
      "enum": [
        "review_required",
        "reviewed_public_domain_attribution_required",
        "reviewed_permitted_with_conditions",
        "use_restricted"
      ]
    },
    "warning": {
      "type": "string",
      "minLength": 10
    },
    "rights_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source_id",
        "dataset_version",
        "purpose",
        "registry_sha256",
        "evaluation",
        "rights_status"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]{3,100}$"
        },
        "dataset_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "purpose": {
          "enum": [
            "research",
            "public_aggregates",
            "commercial"
          ]
        },
        "registry_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "evaluation": {
          "enum": [
            "not_supplied",
            "invalid_registry",
            "pending_or_unmatched",
            "reviewed_record"
          ]
        },
        "rights_status": {
          "enum": [
            "review_required",
            "reviewed_public_domain_attribution_required",
            "reviewed_permitted_with_conditions",
            "use_restricted"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evaluation": {
                "const": "not_supplied"
              }
            },
            "required": [
              "evaluation"
            ]
          },
          "then": {
            "properties": {
              "registry_sha256": {
                "type": "null"
              },
              "rights_status": {
                "const": "review_required"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evaluation": {
                "const": "invalid_registry"
              }
            },
            "required": [
              "evaluation"
            ]
          },
          "then": {
            "properties": {
              "rights_status": {
                "const": "review_required"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evaluation": {
                "const": "pending_or_unmatched"
              }
            },
            "required": [
              "evaluation"
            ]
          },
          "then": {
            "properties": {
              "rights_status": {
                "const": "review_required"
              },
              "registry_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evaluation": {
                "const": "reviewed_record"
              }
            },
            "required": [
              "evaluation"
            ]
          },
          "then": {
            "properties": {
              "registry_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "rights_status": {
                "enum": [
                  "reviewed_public_domain_attribution_required",
                  "reviewed_permitted_with_conditions",
                  "use_restricted"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
