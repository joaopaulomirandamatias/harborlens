{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/joaopaulomirandamatias/harborlens/main/schemas/v1/noaa-anchorage-collection.schema.json",
  "title": "Current NOAA polygon source, not authoritative historical berth/waiting truth",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "features"
  ],
  "properties": {
    "type": {
      "const": "FeatureCollection"
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": [
          "type",
          "id",
          "geometry",
          "properties"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "Feature"
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "geometry": {
            "type": "object",
            "required": [
              "type",
              "coordinates"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "Polygon",
                  "MultiPolygon"
                ]
              },
              "coordinates": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          "properties": {
            "type": "object",
            "required": [
              "source_object_id",
              "source_layer",
              "source_name",
              "geometry_review_status",
              "historical_validity",
              "event_verification"
            ],
            "additionalProperties": false,
            "properties": {
              "source_object_id": {
                "type": "integer",
                "minimum": 0
              },
              "source_layer": {
                "type": "string",
                "minLength": 1
              },
              "source_name": {
                "type": "string"
              },
              "geometry_review_status": {
                "const": "unreviewed"
              },
              "historical_validity": {
                "const": "not_verified"
              },
              "event_verification": {
                "const": "not_verified"
              }
            }
          }
        }
      }
    }
  }
}
