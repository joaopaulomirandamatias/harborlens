{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/joaopaulomirandamatias/harborlens/main/schemas/v1/cfr-2024-anchorages-audit.schema.json",
  "title": "2024 USCG regulatory anchorage DMS transcription: datum and literal topology gates",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_authority",
    "source_url",
    "regulation",
    "regulation_general_datum_caveat",
    "source_edition_date",
    "reference_version",
    "evidence_date_scope",
    "study_date",
    "regulatory_text_digest",
    "areas",
    "source_regulatory_date_validity",
    "source_document_authenticity",
    "rights_status",
    "warning"
  ],
  "properties": {
    "schema_version": {
      "const": "regulatory-anchorage-audit-v1"
    },
    "source_authority": {
      "const": "US Government Publishing Office annual CFR"
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "regulation": {
      "const": "33 CFR 110.197"
    },
    "regulation_general_datum_caveat": {
      "const": "33 CFR 110.1(d)"
    },
    "source_edition_date": {
      "const": "2024-07-01"
    },
    "reference_version": {
      "const": "cfr-2024-title33-vol1-sec110-197-v1"
    },
    "evidence_date_scope": {
      "enum": [
        "prior_to_available_annual_edition_unverified",
        "documented_at_2024_annual_edition_only"
      ]
    },
    "study_date": {
      "type": "string",
      "format": "date"
    },
    "regulatory_text_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "areas": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "display_name",
          "source_reference",
          "source_datum",
          "source_lat_lon_dms",
          "transcribed_lon_lat_in_source_datum",
          "ring_closed",
          "literal_ring_topology",
          "topology_detail",
          "historical_study_status",
          "review_blockers",
          "ais_spatial_join_permitted",
          "verified_anchorage_or_waiting"
        ],
        "properties": {
          "id": {
            "enum": [
              "A",
              "B",
              "C",
              "A_EAST"
            ]
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "source_reference": {
            "const": "33 CFR 110.197(a)"
          },
          "source_datum": {
            "enum": [
              "NAD83_explicit",
              "not_explicitly_specified"
            ]
          },
          "source_lat_lon_dms": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": [
                "latitude",
                "longitude"
              ],
              "additionalProperties": false,
              "properties": {
                "latitude": {
                  "type": "string"
                },
                "longitude": {
                  "type": "string"
                }
              }
            }
          },
          "transcribed_lon_lat_in_source_datum": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                }
              ],
              "items": false
            }
          },
          "ring_closed": {
            "const": true
          },
          "literal_ring_topology": {
            "enum": [
              "valid_literal_ring",
              "invalid_literal_ring"
            ]
          },
          "topology_detail": {
            "type": "string"
          },
          "historical_study_status": {
            "enum": [
              "prior_to_available_annual_edition_unverified",
              "documented_at_2024_annual_edition_only"
            ]
          },
          "review_blockers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "ais_spatial_join_permitted": {
            "const": false
          },
          "verified_anchorage_or_waiting": {
            "const": false
          }
        }
      }
    },
    "source_regulatory_date_validity": {
      "const": "as_of_2024_07_01_only"
    },
    "source_document_authenticity": {
      "const": "official_public_web_reference_not_locally_hash_verified"
    },
    "rights_status": {
      "const": "review_required_for_downstream_datasets"
    },
    "warning": {
      "type": "string",
      "minLength": 50
    }
  }
}
