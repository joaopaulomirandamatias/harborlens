{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/joaopaulomirandamatias/harborlens/main/schemas/v1/usace-facility-collection.schema.json",
  "title": "USACE facility reference points; not verified berth or anchorage polygons",
  "type": "object",
  "required": [
    "type",
    "features"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "FeatureCollection"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "id",
          "geometry",
          "properties"
        ],
        "properties": {
          "type": {
            "const": "Feature"
          },
          "id": {
            "type": "string"
          },
          "geometry": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "coordinates"
            ],
            "properties": {
              "type": {
                "const": "Point"
              },
              "coordinates": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  }
                ],
                "items": false
              }
            }
          },
          "properties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "objectid",
              "nav_unit_id",
              "nav_unit_name",
              "fac_type",
              "port_name",
              "wtwy_name",
              "data_record_status",
              "facility_status",
              "event_verification"
            ],
            "properties": {
              "objectid": {
                "type": "integer"
              },
              "nav_unit_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "nav_unit_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "fac_type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "port_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "wtwy_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "data_record_status": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "facility_status": {
                "const": "reference_point_only"
              },
              "event_verification": {
                "const": "not_verified"
              }
            }
          }
        }
      }
    }
  }
}
